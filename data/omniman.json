      "name": "Thraxa",
      "image": "https://media.discordapp.net/attachments/1518466128396025948/1519010070040674424/6b04b1d468e91e59338b222d51754fe2.png?ex=6a3bffde&is=6a3aae5e&hm=54009fe0a825aff6ac343be753c976c1ad0b612cc55fb0a9427a4d7dcb1b81c7&=&format=webp&quality=lossless",
